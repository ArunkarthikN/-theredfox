server {
    server_name theredfox.us www.theredfox.us;

    # Frontend (Next.js)
    location / {
        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

	# Backend API (Node.js/Express)
    	location /api/ {
        # The trailing slash on the URL below is crucial
        proxy_pass http://127.0.0.1:5000; 
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # Force Nginx to pass the body and headers
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Ensure the body size is allowed (for long articles)
        client_max_body_size 10M;
    }
    # Automation (n8n)
    location /n8n/ {
        proxy_pass http://localhost:5678;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        
        # n8n specifically needs these for the UI to work correctly over a proxy
        chunked_transfer_encoding off;
        proxy_buffering off;
        proxy_cache off;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/theredfox.us/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/theredfox.us/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.theredfox.us) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = theredfox.us) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    server_name theredfox.us www.theredfox.us;
    listen 80;
    return 404; # managed by Certbot
}
